# Local dev: point at a local SQLite file (path is resolved relative to the
# repo root, since that's the process cwd for both `next dev`/`next start`
# and the Prisma CLI here — not relative to prisma/schema.prisma).
DATABASE_URL="file:./prisma/dev.db"
TURSO_DATABASE_URL="file:./prisma/dev.db"

# Production (Vercel): point at your Turso database instead.
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<token>"
